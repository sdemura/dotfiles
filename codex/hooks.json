{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/sean/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/agent-status.py\" codex",
            "timeout": 3
          }
        ],
        "matcher": "^(startup|resume)$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/sean/.codex/hooks/codex-policy.mjs'",
            "timeout": 10,
            "statusMessage": "Checking local and review-write policy"
          }
        ],
        "matcher": "^(Bash|mcp__.*)$"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/agent-status.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/agent-status.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/agent-status.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/agent-status.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/agent-status.py\" codex",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/agent-status.py\" codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
